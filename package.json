{
  "name": "phtml-runtime",
  "version": "1.0.0",
  "description": "Agentic HTML presentation runtime — beautiful by default, editable by AI",
  "keywords": ["presentation", "slides", "agent", "ai", "html", "runtime", "phtml"],
  "author": "imejaim",
  "license": "MIT",
  "main": "runtime/phtml.js",
  "bin": {
    "phtml": "./cli/index.js"
  },
  "files": [
