    "dev": "node cli/index.js serve --open"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/imejaim/phtml-runtime.git"
  },
  "homepage": "https://github.com/imejaim/phtml-runtime"
